{
  "name": "interactive-maths",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:offline": "node scripts/check-offline.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "apk:build": "powershell -ExecutionPolicy Bypass -File scripts/build-signed-apk.ps1",
    "test": "node --test scripts/worksheet-commands.test.mjs scripts/question-layout.test.mjs scripts/check-data-sync.mjs",
    "test:canvas": "node scripts/check-canvas.mjs",
    "test:presentation": "node scripts/check-presentation.mjs",
    "test:print": "node scripts/check-print-button.mjs",
    "test:settings": "node scripts/check-settings.mjs",
    "test:vector-print": "node scripts/check-vector-print.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@types/katex": "^0.16.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/edge": "^1.3.2",
    "better-react-mathjax": "2.4.0-beta-1",
    "katex": "^0.19.1",
    "lucide-react": "0.411.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "10.6.1",
    "esbuild": "0.25.12",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
