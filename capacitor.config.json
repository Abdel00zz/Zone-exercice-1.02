{
  "appId": "com.zoneexercice.app",
  "appName": "Zone Exercice",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#0f172a",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0f172a"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "useLegacyBridge": false,
    "backgroundColor": "#0f172a",
    "buildOptions": {
      "keystorePath": "./android.keystore",
      "keystoreAlias": "studioalgebre",
      "releaseType": "APK"
    }
  }
}
