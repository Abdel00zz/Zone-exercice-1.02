{
  "appId": "app.studioalgebre.twa",
  "appName": "Zone Exercice",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#f4f3ee",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#f4f3ee"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "useLegacyBridge": false,
    "backgroundColor": "#f4f3ee",
    "buildOptions": {
      "keystorePath": "./android.keystore",
      "keystoreAlias": "studioalgebre",
      "releaseType": "APK"
    }
  }
}
